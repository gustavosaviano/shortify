#!/usr/bin/env bash
# Fake ansible-playbook: a recap line, then exit $FAKE_DEPLOY_RC (0 by default).
# FAKE_DEPLOY_LINGER=<s>: leave a process behind that outlives the deploy, as an SSH
# ControlPersist master does; its PID goes to $FAKE_STATE/linger.pid.
echo "ansible-playbook INSTANCE_ID=${INSTANCE_ID:-} $*" >> "$FAKE_LOG"
echo "shortify-app               : ok=20   changed=12   unreachable=0    failed=0"
if [ -n "${FAKE_DEPLOY_LINGER:-}" ]; then
  sleep "$FAKE_DEPLOY_LINGER" > /dev/null 2>&1 &
  echo $! > "$FAKE_STATE/linger.pid"
fi
if [ "${FAKE_DEPLOY_RC:-0}" != 0 ]; then echo "fatal: [shortify-app]: fake deploy failure"; fi
exit "${FAKE_DEPLOY_RC:-0}"
