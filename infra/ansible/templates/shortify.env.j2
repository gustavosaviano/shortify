# Managed by Ansible (infra/ansible/app.yml). No secrets here: the app reads the
# database password from Secrets Manager at start (app/database.py).
DATABASE_SECRET_ARN={{ tf.db_master_secret_arn.value }}
DATABASE_HOST={{ tf.db_endpoint.value.address }}
DATABASE_PORT={{ tf.db_endpoint.value.port }}
DATABASE_NAME={{ tf.db_endpoint.value.name }}
{% if aws_endpoint_url is defined %}
# Floci only (inventories/floci): the same AWS credential chain, another endpoint.
AWS_ENDPOINT_URL={{ aws_endpoint_url }}
{% endif %}
